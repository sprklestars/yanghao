# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Telegram
# ⚠️ 下面两行是占位示例，必须替换成 my.telegram.org → API development tools
# 里你自己 App 的真实值；照抄示例会得到 "The api_id/api_hash combination is invalid"
TG_API_ID=12345678
TG_API_HASH=your-telegram-api-hash
# 代理（留空 = 直连）；协议要和代理软件实际监听的一致，否则会一直连不上
TG_PROXY_URL=socks5://127.0.0.1:7890

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/dbname

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# API 访问令牌：留空 = 本机不鉴权；填了之后前端/守护进程都要带上同一个值
API_TOKEN=

# App
APP_ENV=development
LOG_LEVEL=INFO
