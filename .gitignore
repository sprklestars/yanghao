# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# 注意：必须是 /lib/ 这种锚定到仓库根的写法。
# 原来的 "lib/" 会连 frontend/src/lib/ 一起忽略，导致前端 API 客户端从未被提交。
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environment
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Sessions (contains credentials)
sessions/
*.session
*.session-journal

# Environment variables
.env
.env.local
.env.*.local

# Local credentials / secrets docs (never commit)
CREDENTIALS.local.md
*.secret.md
secrets/

# Database
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# 运行时共享状态（黑名单等，跨进程用）
state/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Playwright
.playwright/

# Node modules（任意层级：根目录、frontend 或以后新增的子项目都覆盖）
node_modules/
frontend/.next/
frontend/out/
# TypeScript 增量编译缓存（tsc --noEmit / next build 会生成）
*.tsbuildinfo

# Backend build
backend/build/
backend/dist/

# Test sessions
test_session*

# Temporary files
*.tmp
*.temp
*.pid
tmp/
temp/
